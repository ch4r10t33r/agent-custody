# Copy to .env. The .env file is gitignored; nothing here is committed.

# The published receipts version to build the image from.
AGENT_CUSTODY_VERSION=0.5.0

# Bearer token the gateway and SDK present on append. Generate one: openssl rand -hex 32
# Give it to the operator as the value of the environment variable their config names in log.tokenEnv.
AGENT_CUSTODY_LOG_TOKEN=

# The id written into every tree head this log signs; verifiers check it with --log-id. Use the public host.
AGENT_CUSTODY_LOG_ID=log.example.com

# Shared secret between the log and the signer: openssl rand -hex 32
SIGNER_TOKEN=

# The operator's admin page at https://<LOG_HOST>/admin needs this token: openssl rand -hex 32. Leave empty for no admin page.
ADMIN_TOKEN=

# Public hosts for the --profile public setup; Caddy obtains certificates for both.
LOG_HOST=log.example.com
CHECKPOINTS_HOST=checkpoints.example.com

# Seconds between checkpoint publications.
AGENT_CUSTODY_CHECKPOINT_EVERY=300

# Postgres password for the leaves, tenants, and tokens store: openssl rand -hex 24
POSTGRES_PASSWORD=
