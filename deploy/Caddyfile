# TLS at the edge, certificate from Let's Encrypt, the log server behind it. LOG_HOST comes from .env.
{$LOG_HOST} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy log:8787
}

# The published checkpoints: plain files, one per tree size and a latest.json per log, served read-only.
{$CHECKPOINTS_HOST} {
	root * /srv/checkpoints
	file_server browse
	header {
		Cache-Control "public, max-age=60"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
