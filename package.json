{
  "name": "agent-custody",
  "version": "0.1.0",
  "description": "Chain of custody for AI agents: what an agent did and what it believes, signed, verifiable, and revertible",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "demo": "bun run --cwd packages/receipts demo"
  },
  "engines": {
    "node": ">=22"
  }
}
